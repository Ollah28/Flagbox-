# Flagbox settings. Flagbox does NOT read a .env file: set these as environment variables
# in your shell if you want to change a default. In PowerShell, for example:
#     $env:FLAGBOX_MODEL = "qwen3:14b"
# Every setting below is optional; the values shown are the defaults.
OLLAMA_HOST=http://127.0.0.1:11434
FLAGBOX_MODEL=qwen3:8b
FLAGBOX_NUM_CTX=16384
# Used by the MCP server when it is started on its own (`flagbox run` passes these itself):
FLAGBOX_DATA_DIR=./data
FLAGBOX_CONFIG=./config/indicators.yaml
FLAGBOX_DRAFTS_DIR=./drafts
